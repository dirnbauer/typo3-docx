    <unit id="settings.jevMaxCandidates">
      <segment>
        <source>Jev candidates: how many of the best structural fits Jev chooses between (2–12).</source>
      </segment>
    </unit>
    <unit id="settings.jevCacheLifetime">
      <segment>
        <source>Jev cache lifetime (seconds): how long Jev's answer for the same part is reused; -1 uses webcon_jev's setting.</source>
      </segment>
    </unit>
