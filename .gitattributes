# Development files stay out of the Composer dist archive. The built editor
# bundle (Resources/Public/Vite/) is shipped on purpose.
/.github export-ignore
/Build export-ignore
/Tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpstan.neon export-ignore
/vite.config.js export-ignore
# CI rebuilds the bundle and compares it byte for byte: store it as built,
# without line-ending normalisation (one font licence ships with CRLF).
/Resources/Public/Vite/** -text
